<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Soundboard.Input</RootNamespace>
    <!-- Hook callbacks read the native KBDLLHOOKSTRUCT/MSLLHOOKSTRUCT through pointers: no marshalling allocations, nothing slow on the hook thread. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Soundboard.Input.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Soundboard.Core\Soundboard.Core.csproj" />
  </ItemGroup>
</Project>
