<Window x:Class="Soundboard.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Soundboard.App.ViewModels"
        Title="{Binding Title}"
        Icon="/Assets/app.ico"
        Width="1100" Height="720" MinWidth="860" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}">
  <Window.Resources>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="TileStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource TileBrush}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource TileHoverBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="DevicePicker">
      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
    </DataTemplate>
  </Window.Resources>

  <DockPanel>
    <!-- Top bar: devices and the mic LED -->
    <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" Padding="16,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,12,0" ToolTip="{Binding MicStatusText}">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding MicStatus, Converter={StaticResource StatusToBrush}}" />
            <TextBlock Style="{StaticResource Caption}" Text="Micro thật" />
          </StackPanel>
          <ComboBox Margin="0,4,0,0" HorizontalAlignment="Stretch" ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}" ItemTemplate="{StaticResource DevicePicker}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="0,0,12,0" ToolTip="{Binding GameStatusText}">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding GameStatus, Converter={StaticResource StatusToBrush}}" />
            <TextBlock Style="{StaticResource Caption}" Text="Output A → game (VB-Cable)" />
          </StackPanel>
          <ComboBox Margin="0,4,0,0" HorizontalAlignment="Stretch" ItemsSource="{Binding GameOutputs}" SelectedItem="{Binding SelectedGameOutput}" ItemTemplate="{StaticResource DevicePicker}" />
        </StackPanel>

        <StackPanel Grid.Column="2" Margin="0,0,12,0" ToolTip="{Binding MonitorStatusText}">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding MonitorStatus, Converter={StaticResource StatusToBrush}}" />
            <TextBlock Style="{StaticResource Caption}" Text="Output B → tai nghe của bạn" />
          </StackPanel>
          <ComboBox Margin="0,4,0,0" HorizontalAlignment="Stretch" ItemsSource="{Binding MonitorOutputs}" SelectedItem="{Binding SelectedMonitorOutput}" ItemTemplate="{StaticResource DevicePicker}" />
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
          <Border Padding="10,6" CornerRadius="14" Background="{StaticResource SurfaceAltBrush}" ToolTip="Sáng khi giọng bạn đang được truyền tới game">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="12" Height="12" VerticalAlignment="Center" Fill="{Binding IsVoiceTransmitting, Converter={StaticResource LedBrush}}" />
              <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="MIC" />
            </StackPanel>
          </Border>
          <Button Margin="8,0,0,0" Content="+ Thêm sound" Style="{StaticResource AccentButtonStyle}" Command="{Binding ImportCommand}" />
          <Button Margin="8,0,0,0" Content="⟳" ToolTip="Làm mới danh sách thiết bị" Command="{Binding RefreshDevicesCommand}" />
          <Button Margin="8,0,0,0" Content="Phím tắt chung" Command="{Binding OpenHotkeysCommand}" />
          <Button Margin="8,0,0,0" Content="Hướng dẫn" Command="{Binding OpenSetupCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Missing VB-Cable banner -->
    <Border DockPanel.Dock="Top" Padding="16,8" Background="{StaticResource WarningBackgroundBrush}"
            Visibility="{Binding ShowCableBanner, Converter={StaticResource BoolToVisibility}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Xem hướng dẫn" Command="{Binding OpenSetupCommand}" />
        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                   Text="Chưa tìm thấy VB-Audio Virtual Cable nên đồng đội chưa nghe được gì. Hãy cài VB-Cable rồi khởi động lại máy." />
      </DockPanel>
    </Border>

    <!-- Status line -->
    <Border DockPanel.Dock="Bottom" Padding="16,4" Background="{StaticResource SurfaceAltBrush}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding SettingsStatus}" />
        <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- Bottom bar: levels and switches -->
    <Border DockPanel.Dock="Bottom" Padding="16,10" Background="{StaticResource SurfaceBrush}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,16,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding VolumeToGameText}" />
            <TextBlock Style="{StaticResource Caption}" Text="Sound → đồng đội" />
          </DockPanel>
          <Slider Minimum="0" Maximum="{Binding MaxSoundVolume}" SmallChange="0.01" LargeChange="0.1" Value="{Binding VolumeToGame}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="0,0,16,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding VolumeToMonitorText}" />
            <TextBlock Style="{StaticResource Caption}" Text="Sound → tai nghe" />
          </DockPanel>
          <Slider Minimum="0" Maximum="{Binding MaxSoundVolume}" SmallChange="0.01" LargeChange="0.1" Value="{Binding VolumeToMonitor}" />
        </StackPanel>

        <StackPanel Grid.Column="2" Margin="0,0,16,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding MicVolumeText}" />
            <TextBlock Style="{StaticResource Caption}" Text="Giọng của bạn" />
          </DockPanel>
          <Slider Minimum="0" Maximum="{Binding MaxMicVolume}" SmallChange="0.01" LargeChange="0.1" Value="{Binding MicVolume}" />
        </StackPanel>

        <StackPanel Grid.Column="3" Margin="0,0,16,0" VerticalAlignment="Center">
          <CheckBox Content="Mic luôn mở (không cần PTT)" IsChecked="{Binding MicAlwaysOn}" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,4">
            <Run Text="Phím PTT:" />
            <Run Text="{Binding PttHotkeyText, Mode=OneWay}" />
          </TextBlock>
          <CheckBox Content="Sound mới dừng sound cũ" IsChecked="{Binding ExclusivePlayback}" />
          <CheckBox Content="Khởi động cùng Windows" IsChecked="{Binding StartWithWindows}" />
        </StackPanel>

        <StackPanel Grid.Column="4" VerticalAlignment="Center" Width="200">
          <Button HorizontalAlignment="Stretch" Padding="16,8" Content="■  Dừng tất cả" Command="{Binding StopAllCommand}" />
          <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Text="{Binding NowPlaying}" TextTrimming="CharacterEllipsis" ToolTip="{Binding NowPlaying}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Sound grid; dropping audio files anywhere here imports them -->
    <Grid AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" Background="Transparent">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
        <ItemsControl ItemsSource="{Binding Tiles}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:SoundTileViewModel}">
              <Border Width="172" Height="110" Margin="6" CornerRadius="10" Cursor="Hand" Style="{StaticResource TileStyle}"
                      ToolTip="{Binding Name}"
                      MouseLeftButtonDown="OnTileMouseDown" MouseLeftButtonUp="OnTileMouseUp" LostMouseCapture="OnTileLostCapture">
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Sửa" Command="{Binding EditCommand}" />
                    <MenuItem Header="Đổi phím" Command="{Binding ChangeKeyCommand}" />
                    <MenuItem Header="Nhân bản" Command="{Binding DuplicateCommand}" />
                    <Separator />
                    <MenuItem Header="Xóa" Command="{Binding DeleteCommand}" />
                  </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                  <Border Height="6" VerticalAlignment="Top" CornerRadius="10,10,0,0" Background="{Binding Color, Converter={StaticResource HexToBrush}}" />
                  <StackPanel Margin="12,16,12,0">
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{Binding HotkeyText}" />
                  </StackPanel>
                  <ProgressBar Height="4" MinHeight="4" Margin="12,0,12,10" VerticalAlignment="Bottom" Maximum="1"
                               Value="{Binding Progress, Mode=OneWay}"
                               Foreground="{Binding Color, Converter={StaticResource HexToBrush}}"
                               Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                  Visibility="{Binding HasNoSounds, Converter={StaticResource BoolToVisibility}}">
        <TextBlock HorizontalAlignment="Center" FontSize="18" Foreground="{StaticResource MutedForegroundBrush}" Text="Chưa có sound nào" />
        <TextBlock Margin="0,6,0,12" HorizontalAlignment="Center" Foreground="{StaticResource MutedForegroundBrush}"
                   Text="Kéo thả file âm thanh (wav, mp3, ogg, flac…) vào đây, hoặc:" />
        <Button HorizontalAlignment="Center" Padding="16,8" Content="+ Thêm sound" Style="{StaticResource AccentButtonStyle}" Command="{Binding ImportCommand}" />
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
