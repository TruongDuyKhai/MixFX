<Window x:Class="Soundboard.App.Views.YouTubeDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tải từ YouTube"
        Icon="/Assets/app.ico"
        Width="560" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=UrlBox}"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}">
  <StackPanel Margin="20">
    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Tải nhạc từ YouTube" />
    <TextBlock Margin="0,4,0,12" Foreground="{StaticResource MutedForegroundBrush}" TextWrapping="Wrap" Text="{Binding Notice}" />

    <Border Margin="0,0,0,12" Padding="14,10" CornerRadius="8" Background="{StaticResource SurfaceBrush}"
            Visibility="{Binding NeedsTools, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <TextBlock TextWrapping="Wrap" Text="{Binding ConsentText}" />
        <Button Margin="0,10,0,0" HorizontalAlignment="Left" Padding="14,6" Content="Tải công cụ"
                Style="{StaticResource AccentButtonStyle}" Command="{Binding InstallToolsCommand}" />
      </StackPanel>
    </Border>

    <TextBlock Text="Link video YouTube" />
    <TextBox x:Name="UrlBox" Margin="0,4,0,0" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />

    <ProgressBar Margin="0,12,0,0" Height="6" Minimum="0" Maximum="1"
                 Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    <TextBlock Margin="0,8,0,0" MinHeight="18" TextWrapping="Wrap" Text="{Binding StatusText}">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsError}" Value="True">
              <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <DockPanel Margin="0,14,0,0" LastChildFill="False">
      <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12"
                 Foreground="{StaticResource MutedForegroundBrush}" Text="{Binding ToolsText}" />
      <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="16,6" Content="{Binding CancelText}" Command="{Binding CancelCommand}" />
      <Button DockPanel.Dock="Right" Padding="16,6" Content="Tải về" IsDefault="True"
              Style="{StaticResource AccentButtonStyle}" Command="{Binding DownloadCommand}" />
    </DockPanel>
  </StackPanel>
</Window>
