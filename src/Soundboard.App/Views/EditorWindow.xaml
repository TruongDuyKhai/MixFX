<Window x:Class="Soundboard.App.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Soundboard.App.Views.Controls"
        Title="Sửa sound"
        Icon="/Assets/app.ico"
        Width="860" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}">
  <Window.Resources>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
  </Window.Resources>

  <StackPanel Margin="20">
    <!-- Name and colour -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,16,0">
        <TextBlock Style="{StaticResource Caption}" Text="Tên" />
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
      <StackPanel Grid.Column="1">
        <TextBlock Style="{StaticResource Caption}" Text="Màu" />
        <StackPanel Orientation="Horizontal">
          <Border Width="28" Height="28" Margin="0,0,10,0" CornerRadius="6" Background="{Binding Color, Converter={StaticResource HexToBrush}}" />
          <ItemsControl ItemsSource="{Binding Colors}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Width="20" Height="20" Margin="2" Cursor="Hand" ToolTip="{Binding}"
                        Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border CornerRadius="10" Background="{Binding Converter={StaticResource HexToBrush}}" />
                    </ControlTemplate>
                  </Button.Template>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- Waveform with trim markers -->
    <Border Margin="0,16,0,0" Padding="6" CornerRadius="8" Background="{StaticResource SurfaceBrush}">
      <Grid Height="170">
        <controls:WaveformView Peaks="{Binding Peaks}" DurationMs="{Binding DurationMs}"
                               TrimStartMs="{Binding TrimStartMs}" TrimEndMs="{Binding TrimEndMs}"
                               FadeInMs="{Binding FadeInMs}" FadeOutMs="{Binding FadeOutMs}"
                               MinTrimmedMs="{Binding MinTrimmedMs}" />
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedForegroundBrush}"
                   Text="Đang đọc file…" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </Border>
    <DockPanel Margin="0,6,0,0">
      <Button DockPanel.Dock="Right" Content="Bỏ cắt" Command="{Binding ResetTrimCommand}" />
      <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}">
        <Run Text="Kéo hai vạch vàng để cắt. Độ dài sau cắt:" />
        <Run Text="{Binding TrimmedText, Mode=OneWay}" />
      </TextBlock>
    </DockPanel>

    <!-- Numbers -->
    <UniformGrid Margin="0,12,0,0" Columns="4">
      <StackPanel Margin="0,0,12,0">
        <TextBlock Style="{StaticResource Caption}" Text="Bắt đầu (ms)" />
        <TextBox Text="{Binding TrimStartMs, StringFormat={}{0:0}, UpdateSourceTrigger=LostFocus}" />
      </StackPanel>
      <StackPanel Margin="0,0,12,0">
        <TextBlock Style="{StaticResource Caption}" Text="Kết thúc (ms)" />
        <TextBox Text="{Binding TrimEndMs, StringFormat={}{0:0}, UpdateSourceTrigger=LostFocus}" />
      </StackPanel>
      <StackPanel Margin="0,0,12,0">
        <TextBlock Style="{StaticResource Caption}" Text="Fade in (ms)" />
        <TextBox Text="{Binding FadeInMs, StringFormat={}{0:0}, UpdateSourceTrigger=LostFocus}" />
      </StackPanel>
      <StackPanel>
        <TextBlock Style="{StaticResource Caption}" Text="Fade out (ms)" />
        <TextBox Text="{Binding FadeOutMs, StringFormat={}{0:0}, UpdateSourceTrigger=LostFocus}" />
      </StackPanel>
    </UniformGrid>

    <!-- Levels -->
    <Grid Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding GainText}" />
          <TextBlock Style="{StaticResource Caption}" Text="Gain (chỉnh độ to của file)" />
        </DockPanel>
        <Slider Minimum="{Binding MinGainDb}" Maximum="{Binding MaxGainDb}" SmallChange="0.5" LargeChange="3" Value="{Binding GainDb}" />
      </StackPanel>
      <Button Grid.Column="1" Margin="12,0" VerticalAlignment="Bottom" Content="Normalize" ToolTip="Tự chỉnh gain để đỉnh đoạn đã cắt đạt −1 dBFS" Command="{Binding NormalizeCommand}" />
      <StackPanel Grid.Column="2">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding VolumeText}" />
          <TextBlock Style="{StaticResource Caption}" Text="Âm lượng trên soundboard" />
        </DockPanel>
        <Slider Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" Value="{Binding Volume}" />
      </StackPanel>
    </Grid>

    <!-- Effects (FeatureFlags.SoundEffects) -->
    <Grid Margin="0,14,0,0" Visibility="{Binding EffectsEnabled, Converter={StaticResource BoolToVisibility}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,12,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding PitchText}" />
          <TextBlock Style="{StaticResource Caption}" Text="Cao độ (pitch)" />
        </DockPanel>
        <Slider Minimum="-12" Maximum="{Binding MaxPitch}" SmallChange="0.5" LargeChange="1" Value="{Binding PitchSemitones}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,12,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding ReverbText}" />
          <TextBlock Style="{StaticResource Caption}" Text="Reverb (độ vang)" />
        </DockPanel>
        <Slider Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding ReverbWet}" />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Style="{StaticResource Caption}" Text="Kích thước phòng" />
        <Slider Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding ReverbRoom}" />
      </StackPanel>
    </Grid>

    <TextBlock Margin="0,10,0,0" Style="{StaticResource Caption}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />

    <!-- Actions -->
    <DockPanel Margin="0,12,0,0" LastChildFill="False">
      <Button DockPanel.Dock="Left" Content="▶  Nghe thử" ToolTip="Chỉ phát ra tai nghe, đồng đội không nghe thấy" Command="{Binding PreviewCommand}" />
      <Button DockPanel.Dock="Left" Margin="8,0,0,0" Content="■  Dừng" Command="{Binding StopPreviewCommand}" />
      <Button DockPanel.Dock="Left" Margin="8,0,0,0" Content="Export WAV…" Command="{Binding ExportCommand}" />
      <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Hủy" Command="{Binding CancelCommand}" />
      <Button DockPanel.Dock="Right" Content="Lưu" Command="{Binding SaveCommand}" IsDefault="True" />
    </DockPanel>
  </StackPanel>
</Window>
