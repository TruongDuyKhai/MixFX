<Window x:Class="Soundboard.App.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hướng dẫn cài đặt"
        Icon="/Assets/app.ico"
        Width="640" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}">
  <Window.Resources>
    <Style x:Key="Step" TargetType="Border">
      <Setter Property="Margin" Value="0,6" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    </Style>
    <Style x:Key="StepTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
    </Style>
  </Window.Resources>

  <StackPanel Margin="20">
    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Phát sound qua micro trong Valorant" />
    <TextBlock Margin="0,4,0,10" Style="{StaticResource Body}"
               Text="Soundboard gửi giọng của bạn cùng với sound vào một micro ảo. Valorant dùng micro ảo đó nên đồng đội nghe được cả hai." />

    <Border Style="{StaticResource Step}">
      <StackPanel>
        <TextBlock Style="{StaticResource StepTitle}" Text="1. Cài VB-Audio Virtual Cable (miễn phí)" />
        <TextBlock FontWeight="SemiBold" Text="{Binding CableStatusText}" Margin="0,0,0,6" />
        <TextBlock Style="{StaticResource Body}" Visibility="{Binding IsCableMissing, Converter={StaticResource BoolToVisibility}}"
                   Text="Tải bản Windows ở trang chính thức của VB-Audio, giải nén, chạy file cài đặt bằng quyền Administrator, rồi khởi động lại máy." />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button Content="Mở trang tải VB-Cable" Command="{Binding OpenDownloadCommand}" />
          <Button Margin="8,0,0,0" Content="Kiểm tra lại" Command="{Binding CheckAgainCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Step}">
      <StackPanel>
        <TextBlock Style="{StaticResource StepTitle}" Text="2. Chọn thiết bị trong Soundboard" />
        <TextBlock Style="{StaticResource Body}">
          <Run Text="• Micro thật: micro bạn đang dùng." /><LineBreak />
          <Run Text="• Output A: để &quot;Tự động&quot;, hoặc chọn &quot;CABLE Input (VB-Audio Virtual Cable)&quot;." /><LineBreak />
          <Run Text="• Output B: tai nghe của bạn, để bạn nghe được sound (bạn không nghe lại giọng mình)." />
        </TextBlock>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Step}">
      <StackPanel>
        <TextBlock Style="{StaticResource StepTitle}" Text="3. Cài đặt trong Valorant" />
        <TextBlock Style="{StaticResource Body}">
          <Run Text="Settings → Audio → Voice Chat:" /><LineBreak />
          <Run Text="• Input Device: &quot;CABLE Output (VB-Audio Virtual Cable)&quot;." /><LineBreak />
          <Run Text="• Chế độ voice: Open Mic (không dùng Push to Talk của game)." /><LineBreak />
          <Run Text="Push-to-talk do Soundboard lo: gán phím ở mục &quot;Phím tắt chung&quot;. Sound luôn được phát, kể cả khi không giữ PTT." />
        </TextBlock>
      </StackPanel>
    </Border>

    <Button Margin="0,14,0,0" HorizontalAlignment="Right" Padding="20,6" Content="Xong" IsCancel="True" IsDefault="True" />
  </StackPanel>
</Window>
