<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Single place for theme colours so views never hard-code them. Control styles come from WPF's Fluent dark theme. -->
  <SolidColorBrush x:Key="BackgroundBrush" Color="#FF1B1B1F" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FF26262C" />
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FF202026" />
  <SolidColorBrush x:Key="TileBrush" Color="#FF2C2C34" />
  <SolidColorBrush x:Key="TileHoverBrush" Color="#FF383842" />
  <SolidColorBrush x:Key="ForegroundBrush" Color="#FFE8E8EC" />
  <SolidColorBrush x:Key="MutedForegroundBrush" Color="#FF9B9BA5" />
  <SolidColorBrush x:Key="AccentBrush" Color="#FF7C4DFF" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#FF43E66B" />
  <SolidColorBrush x:Key="DangerBrush" Color="#FFEF5350" />
  <SolidColorBrush x:Key="WarningBrush" Color="#FFFFB300" />
  <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FF4A3A12" />
  <SolidColorBrush x:Key="LedOffBrush" Color="#FF4A4A55" />
</ResourceDictionary>
