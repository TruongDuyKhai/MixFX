<Application x:Class="Soundboard.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Soundboard.App.Converters"
             ShutdownMode="OnMainWindowClose">
  <!-- No StartupUri: the window is created by DI in App.OnStartup (composition root). -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.Dark.xaml" />
        <ResourceDictionary Source="Themes/Dark.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
      <converters:HexToBrushConverter x:Key="HexToBrush" />
      <converters:EndpointStatusToBrushConverter x:Key="StatusToBrush" />
      <converters:LedBrushConverter x:Key="LedBrush" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
