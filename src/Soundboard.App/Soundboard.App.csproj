<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the system tray icon (NotifyIcon); WPF has none of its own. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Soundboard.App</RootNamespace>
    <AssemblyName>Soundboard</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms' implicit usings would make Application, MessageBox, Button… ambiguous in WPF code. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Soundboard.Core\Soundboard.Core.csproj" />
    <ProjectReference Include="..\Soundboard.Audio\Soundboard.Audio.csproj" />
    <ProjectReference Include="..\Soundboard.Input\Soundboard.Input.csproj" />
    <ProjectReference Include="..\Soundboard.Storage\Soundboard.Storage.csproj" />
  </ItemGroup>
</Project>
